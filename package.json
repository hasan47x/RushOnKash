{
  "name": "rushoncash-ecosystem",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "bot",
    "mini-app",
    "admin-panel",
    "shared"
  ],
  "scripts": {
    "dev:bot": "npm run dev --workspace=bot",
    "dev:mini-app": "npm run dev --workspace=mini-app",
    "dev:admin": "npm run dev --workspace=admin-panel",
    "build:all": "npm run build --workspaces",
    "build:bot": "npm run build --workspace=bot",
    "build:mini-app": "npm run build --workspace=mini-app",
    "build:admin": "npm run build --workspace=admin-panel",
    "lint": "npm run lint --workspaces",
    "db:migrate": "cd supabase && psql $DATABASE_URL -f migrations/001_initial_schema.sql",
    "db:seed": "cd supabase && psql $DATABASE_URL -f seed.sql"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}