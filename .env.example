# RushOnCash - Environment Variables
# Copy this to .env and fill in your values

# ============================================
# Telegram Bot
# ============================================
BOT_TOKEN=your_telegram_bot_token_from_botfather
WEBHOOK_URL=https://your-app.railway.app
WEBHOOK_SECRET=your_secure_webhook_secret
BOT_USERNAME=yourbotname
ADMIN_IDS=123456789,987654321
WITHDRAW_GROUP_ID=-1001234567890

# ============================================
# Supabase
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================
# Frontend URLs
# ============================================
MINI_APP_URL=https://your-mini-app.vercel.app
ADMIN_PANEL_URL=https://admin.yourdomain.com

# ============================================
# App Settings
# ============================================
NODE_ENV=production
PORT=3000
CURRENCY=BDT
CURRENCY_SYMBOL=৳

# ============================================
# Ad Networks (configure in admin panel)
# ============================================
MONETAG_ZONE_ID=9707941
ADSGRAM_BLOCK_ID=int-27948
GIGAPUB_SCRIPTS=https://ad.gigapub.tech/script?id=2607

# ============================================
# Social Links (configure in admin panel)
# ============================================
CHANNEL_USERNAME=@yourchannel
YOUTUBE_CHANNEL_URL=https://youtube.com/@yourchannel
FACEBOOK_PAGE_URL=https://facebook.com/yourpage